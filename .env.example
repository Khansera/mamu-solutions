# OpenRouter API Key: Primary AI provider for natural language, ledger recommendations & bulk analysis
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OpenRouter Model selection: e.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku, deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL="openai/gpt-4o-mini"

# AI Provider choice: 'openrouter' or 'gemini' (defaults to 'openrouter')
AI_PROVIDER="openrouter"

# Google Gemini API Key (optional fallback)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# Tally 7.1 XML Endpoint (default is localhost:9000 on Windows 10)
TALLY_URL="http://localhost:9000"
TALLY_TIMEOUT_SECONDS=10

# Active Target Company in Tally 7.1
TARGET_COMPANY="Chinar Resort & Spa Pvt Ltd. ACUTAL"

# Safety switch: Set to 'true' only after testing imports in a backup/test company.
# Defaults strictly to 'false' (Draft-only mode).
TALLY_WRITE_ENABLED="false"

# Local Server Configuration (Windows 10)
HOST="127.0.0.1"
PORT=8000
APP_URL="MY_APP_URL"
